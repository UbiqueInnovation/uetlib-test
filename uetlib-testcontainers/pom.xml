<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <version>2.0.0-SNAPSHOT</version>
    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-bom</artifactId>
        <version>1.0.0-alpha.9</version>
    </parent>

    <artifactId>uetlib-testcontainers</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>uetlib-testcontainers-mariadb</module>
        <module>uetlib-testcontainers-mongodb</module>
        <module>uetlib-testcontainers-mysql</module>
        <module>uetlib-testcontainers-postgresql</module>
    </modules>

    <properties>
        <spring-boot-version>3.3.5</spring-boot-version>

        <!-- Sonar-->
        <sonar.projectKey>UbiqueInnovation_uetlib-test</sonar.projectKey>
        <sonar.organization>ubiqueinnovation</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-db</artifactId>
            <version>1.0.0-alpha.1</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.xmlunit</groupId>
                    <artifactId>xmlunit-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <type>pom</type>
                <version>${spring-boot-version}</version>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
